<?xml version="1.0" encoding="utf-8"?>
<!--
  Applikationsprogramm des Selfbus KNX/IP Interface.

  Die Kennungen hier muessen zu denen im Geraet passen - Dashboard, Karte
  "Geraeteidentitaet". Aus dem Dateinamen liest die ETS (und das Dashboard)
  Hersteller 0x00FA, Applikation 0x0001, Version 0x01; dieselben Zahlen
  stehen unten dezimal als ApplicationNumber und ApplicationVersion.

  Bewusst ohne Parameter und ohne Kommunikationsobjekte: Diese Firmware wird
  ueber ihr Web-Dashboard eingestellt, nicht ueber die ETS. Was die ETS an
  einem Koppler der Maske 091A einstellt - Filtertabelle und Weiterleitung -
  schreibt sie ueber das Kopplerobjekt, nicht ueber Applikationsparameter.

  Die Ladeprozedur dafuer steht in der Maske, nicht hier (MergedProcedure,
  siehe ../knx_master.xml): Router-Objekt entladen, LCCONFIG setzen,
  Filtertabelle loeschen und schreiben, Laden abschliessen, Neustart.
  LineCoupler0912NewProgrammingStyle waehlt die Fassung, die das ueber das
  Router-Objekt tut - die andere schreibt BCU1-Speicher, den dieser Stack
  nicht hat. Das Programm selbst steuert nur ein Fragment bei: die Pruefung,
  dass der Download ein Geraet dieses Herstellers trifft. Jede weitere
  Property, die es schriebe, muesste es im Stack geben.
-->
<KNX xmlns="http://knx.org/xml/project/14">
  <ManufacturerData>
    <Manufacturer RefId="M-00FA">
      <ApplicationPrograms>
        <ApplicationProgram Id="M-00FA_A-0001-01-0000"
                            ApplicationNumber="1"
                            ApplicationVersion="1"
                            ProgramType="ApplicationProgram"
                            MaskVersion="MV-091A"
                            Name="Selfbus KNX/IP 1.0"
                            LoadProcedureStyle="MergedProcedure"
                            PeiType="0"
                            DefaultLanguage="de-DE"
                            DynamicTableManagement="false"
                            Linkable="false"
                            MinEtsVersion="5.7"
                            AdditionalAddressesCount="10"
                            IsIpEnabled="true"
                            Broken="false">
          <Static>
            <Code />
            <Parameters />
            <ParameterRefs />
            <ComObjectTable />
            <ComObjectRefs />
            <LoadProcedures>
              <!--
                MergeId 1 steht direkt hinter dem Verbindungsaufbau, vor dem
                ersten Schreibzugriff. PID_MANUFACTURER_ID des Geraeteobjekts;
                make_knxprod.py setzt den Wert passend zu dem Hersteller, fuer
                den es baut.
              -->
              <LoadProcedure MergeId="1">
                <LdCtrlCompareProp ObjIdx="0" PropId="12" InlineData="00FA" />
              </LoadProcedure>
            </LoadProcedures>
            <Options LineCoupler0912NewProgrammingStyle="true" />
          </Static>
          <Dynamic />
        </ApplicationProgram>
      </ApplicationPrograms>
    </Manufacturer>
  </ManufacturerData>
</KNX>
