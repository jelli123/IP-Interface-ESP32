<?xml version="1.0" encoding="utf-8"?>
<!--
  Applikationsprogramm des Selfbus KNX/IP Interface.

  Die Kennungen hier muessen zu denen im Geraet passen - Dashboard, Karte
  "Geraeteidentitaet". Aus dem Dateinamen liest die ETS (und das Dashboard)
  Hersteller 0x00FA, Applikation 0x0001, Version 0x02; dieselben Zahlen
  stehen unten dezimal als ApplicationNumber und ApplicationVersion.

  Version 2, weil sich der Inhalt geaendert hat: Version 1 trug die Liste
  BusInterfaces (siehe unten). Eine neue Version ist der Weg, auf dem die
  ETS alte und neue Fassung auseinanderhaelt - gleiche Nummer und Version
  mit anderem Inhalt fuehrt sie als zwei gleichnamige Applikationen.

  Bewusst ohne Parameter und ohne Kommunikationsobjekte: Diese Firmware wird
  ueber ihr Web-Dashboard eingestellt, nicht ueber die ETS. Was die ETS an
  einem Koppler der Maske 091A einstellt - Filtertabelle und Weiterleitung -
  schreibt sie ueber das Kopplerobjekt, nicht ueber Applikationsparameter.

  IPConfig="Tool": Die ETS bietet die IP-Einstellungen in den
  Geraeteeigenschaften an und schreibt sie ins KNXnet/IP-Parameterobjekt.
  Eine dort eingetragene feste Adresse uebernimmt die Firmware, sonst bleibt
  es bei DHCP. So setzt es auch Kaenx-Creator fuer IP-faehige Hardware.

  Die Ladeprozedur dafuer steht in der Maske, nicht hier (MergedProcedure,
  siehe ../knx_master.xml): Router-Objekt entladen, LCCONFIG setzen,
  Filtertabelle loeschen und schreiben, Laden abschliessen, Neustart.
  LineCoupler0912NewProgrammingStyle waehlt die Fassung, die das ueber das
  Router-Objekt tut - die andere schreibt BCU1-Speicher, den dieser Stack
  nicht hat. Das Programm selbst steuert nur ein Fragment bei: die Pruefung,
  dass der Download ein Geraet dieses Herstellers trifft. Jede weitere
  Property, die es schriebe, muesste es im Stack geben.
-->
<KNX xmlns="http://knx.org/xml/project/14">
  <ManufacturerData>
    <Manufacturer RefId="M-00FA">
      <ApplicationPrograms>
        <ApplicationProgram Id="M-00FA_A-0001-02-0000"
                            ApplicationNumber="1"
                            ApplicationVersion="2"
                            ProgramType="ApplicationProgram"
                            MaskVersion="MV-091A"
                            Name="Selfbus KNX/IP"
                            LoadProcedureStyle="MergedProcedure"
                            PeiType="0"
                            DefaultLanguage="de-DE"
                            DynamicTableManagement="false"
                            Linkable="false"
                            MinEtsVersion="5.7"
                            AdditionalAddressesCount="10"
                            IPConfig="Tool"
                            Broken="false">
          <Static>
            <Code />
            <!-- Leer, aber vorhanden: Kaenx-Creator liest die Liste beim
                 Import, ohne zu pruefen, ob es sie gibt. -->
            <ParameterTypes />
            <Parameters />
            <ParameterRefs />
            <ComObjectTable />
            <ComObjectRefs />
            <LoadProcedures>
              <!--
                MergeId 1 steht direkt hinter dem Verbindungsaufbau, vor dem
                ersten Schreibzugriff. PID_MANUFACTURER_ID des Geraeteobjekts;
                make_knxprod.py setzt den Wert passend zu dem Hersteller, fuer
                den es baut.
              -->
              <LoadProcedure MergeId="1">
                <LdCtrlCompareProp ObjIdx="0" PropId="12" InlineData="00FA" />
              </LoadProcedure>
            </LoadProcedures>
            <!--
              Bewusst ohne Static/BusInterfaces. Mit dieser Liste fuehrt die
              ETS 6 die Tunnel als Secure-Tunnel und bietet dafuer eine
              Security-Einstellung an, die dieses Geraet nicht erfuellt.
              Ohne sie beschreibt AdditionalAddressesCount die Tunnel allein,
              und die ETS zeigt schlichte zusaetzliche physikalische Adressen
              - wie bei aelteren Produktdaten derselben Maske.
              Die Option bus-interfaces von make_knxprod.py fuegt die Liste
              wieder ein, fuer den Import in Kaenx-Creator, der ohne sie
              abbricht.
            -->
            <Options LineCoupler0912NewProgrammingStyle="true" />
          </Static>
          <!--
            Die Parameteransicht der ETS: eine einzige Seite, die sagt, wo
            dieses Geraet eingestellt wird. Leer darf der Teil nicht bleiben -
            Kaenx-Creator verweigert den Export ("Dynamic hat keine
            Elemente"), und eine ETS-Seite ohne jeden Hinweis liesse den
            Anwender nach Parametern suchen, die es nicht gibt.
          -->
          <Dynamic>
            <ChannelIndependentBlock>
              <ParameterBlock Id="M-00FA_A-0001-02-0000_PB-1" Name="General" Text="Allgemein">
                <ParameterSeparator Id="M-00FA_A-0001-02-0000_PS-1"
                                    Text="Dieses Gerät wird über sein Web-Dashboard eingestellt, erreichbar unter seiner IP-Adresse oder http://&lt;Gerätename&gt;.local. Die ETS vergibt Adressen und lädt die Filtertabelle."
                                    UIHint="Information" />
              </ParameterBlock>
            </ChannelIndependentBlock>
          </Dynamic>
        </ApplicationProgram>
      </ApplicationPrograms>
    </Manufacturer>
  </ManufacturerData>
</KNX>
