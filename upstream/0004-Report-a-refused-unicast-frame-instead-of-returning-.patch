From d4dca7fc1254fbab69863986cf6df6da6bd25659 Mon Sep 17 00:00:00 2001
From: Selfbus IP interface <noreply@example.invalid>
Date: Tue, 1 Sep 2026 00:27:25 +0200
Subject: [PATCH] Report a refused unicast frame instead of returning true

sendBytesUniCast() logs a failed beginPacket() or endPacket() and
then returns true. Every caller that checks the result is told the
frame went out, so nothing retries and nothing reports an error -
the frame is simply gone.

This is not theoretical. On an ESP32 with WiFi the transmit
buffers run dry when telegrams follow each other closely, which is
exactly what an ETS download does. The symptom is a download that
fails at a random point while the log carries
"sendBytesUniCast endPacket fail" - and, because the failure is
timing dependent, one that disappears as soon as tracing is
switched on.

esp_platform.cpp and libretiny_platform.cpp additionally print
"sendBytesUniCast endPacket fail" unconditionally, before the
packet is even started.

esp32_idf_platform.cpp and linux_platform.cpp already return false
on failure.
---
 src/esp32_platform.cpp          | 16 ++++++++++------
 src/esp_platform.cpp            | 17 ++++++++++-------
 src/libretiny_platform.cpp      | 17 ++++++++++-------
 src/rp2040_arduino_platform.cpp | 16 ++++++++++------
 4 files changed, 40 insertions(+), 26 deletions(-)

diff --git a/src/esp32_platform.cpp b/src/esp32_platform.cpp
index 2f0bfd9..d16f088 100644
--- a/src/esp32_platform.cpp
+++ b/src/esp32_platform.cpp
@@ -149,15 +149,19 @@ bool Esp32Platform::sendBytesUniCast(uint32_t addr, uint16_t port, uint8_t* buff
     if (!port)
         port = _remotePort;
 
-    if (_udp.beginPacket(ucastaddr, port) == 1)
+    if (_udp.beginPacket(ucastaddr, port) != 1)
     {
-        _udp.write(buffer, len);
+        println("sendBytesUniCast beginPacket fail");
+        return false;
+    }
+
+    _udp.write(buffer, len);
 
-        if (_udp.endPacket() == 0)
-            println("sendBytesUniCast endPacket fail");
+    if (_udp.endPacket() == 0)
+    {
+        println("sendBytesUniCast endPacket fail");
+        return false;
     }
-    else
-        println("sendBytesUniCast beginPacket fail");
 
     return true;
 }
