From 3d1ea9b627a6a7f0e0c7a3e58aa00c33cf730565 Mon Sep 17 00:00:00 2001
From: Selfbus IP interface <noreply@example.invalid>
Date: Tue, 22 Sep 2026 13:46:28 +0200
Subject: [PATCH] Report a refused UDP frame instead of returning true

sendBytesUniCast() logs a failed beginPacket() or endPacket() and
then returns true. sendBytesMultiCast() does not even look at the
result. Every caller that checks the return value is told the frame
went out, so nothing retries and nothing reports an error - the
frame is simply gone.

This is not theoretical. On an ESP32 the transmit buffers run dry
when telegrams follow each other closely, which is exactly what an
ETS download does, or when other traffic - a large HTTP transfer -
shares the interface. Unicast loses the answers to a tunnel client,
multicast the answers to ETS programming over routing. The symptom
is a download that fails at a random point and, because the failure
is timing dependent, one that disappears as soon as tracing is
switched on.

esp_platform.cpp and libretiny_platform.cpp additionally print
"sendBytesUniCast endPacket fail" unconditionally, before the
packet is even started.

esp32_idf_platform.cpp and linux_platform.cpp already return false
on failure; the four Arduino platforms now do the same for both
functions.
---
 src/esp32_platform.cpp          | 31 +++++++++++++++++++++++--------
 src/esp_platform.cpp            | 32 +++++++++++++++++++++++---------
 src/libretiny_platform.cpp      | 32 +++++++++++++++++++++++---------
 src/rp2040_arduino_platform.cpp | 31 +++++++++++++++++++++++--------
 4 files changed, 92 insertions(+), 34 deletions(-)

diff --git a/src/esp32_platform.cpp b/src/esp32_platform.cpp
index 2f0bfd9..f30f8f6 100644
--- a/src/esp32_platform.cpp
+++ b/src/esp32_platform.cpp
@@ -103,9 +103,20 @@ void Esp32Platform::closeMultiCast()
 bool Esp32Platform::sendBytesMultiCast(uint8_t* buffer, uint16_t len)
 {
     //printHex("<- ",buffer, len);
-    _udp.beginMulticastPacket();
+    if (_udp.beginMulticastPacket() != 1)
+    {
+        println("sendBytesMultiCast beginPacket fail");
+        return false;
+    }
+
     _udp.write(buffer, len);
-    _udp.endPacket();
+
+    if (_udp.endPacket() == 0)
+    {
+        println("sendBytesMultiCast endPacket fail");
+        return false;
+    }
+
     return true;
 }
 
@@ -149,15 +160,19 @@ bool Esp32Platform::sendBytesUniCast(uint32_t addr, uint16_t port, uint8_t* buff
     if (!port)
         port = _remotePort;
 
-    if (_udp.beginPacket(ucastaddr, port) == 1)
+    if (_udp.beginPacket(ucastaddr, port) != 1)
     {
-        _udp.write(buffer, len);
+        println("sendBytesUniCast beginPacket fail");
+        return false;
+    }
+
+    _udp.write(buffer, len);
 
-        if (_udp.endPacket() == 0)
-            println("sendBytesUniCast endPacket fail");
+    if (_udp.endPacket() == 0)
+    {
+        println("sendBytesUniCast endPacket fail");
+        return false;
     }
-    else
-        println("sendBytesUniCast beginPacket fail");
 
     return true;
 }
